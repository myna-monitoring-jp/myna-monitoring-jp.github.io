# このファイルをコピーして .env.local を作成してください。
# 秘密情報は絶対に置かないこと（バンドルへ埋め込まれ、公開されます）。

# 読み込むデータディレクトリ。live = public/data/、それ以外 = public/sample-data/
VITE_DATA_SOURCE=sample

# サブディレクトリ配信時のベースパス（例: /monitoring/）
VITE_BASE_PATH=./

# N日ルールの既定値。JSONの settings.dashboardQuietDays が優先されます。
VITE_DASHBOARD_QUIET_DAYS=7

# 「新着」とみなす時間。JSONの settings.newItemHours が優先されます。
VITE_NEW_ITEM_HOURS=48

# generatedAt がこれより古い場合に「更新が停滞しています」と警告する時間
VITE_STALE_DATA_HOURS=26

VITE_TIMEZONE=Asia/Tokyo
VITE_ORGANIZATION_LABEL=行政・マイナ関連モニタリング
